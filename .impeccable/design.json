  "narrative": {
    "northStar": "The Test Section",
    "overview": "Testing a PRD is a wind-tunnel run. The document is the model on the sting; the knowledge base is the honeycomb that conditions the flow; generation is the run, with smoke streamlines made visible; and the result is read off a manometer board that shows which coverage areas are full, thin, or dry. Daylight panels for reading, graphite windows for the product's moments.",
    "keyCharacteristics": [
      "Daylight panels for reading; graphite windows for the product's moments",
      "Live SVG streamlines that part around a mounted PRD and speed up during a run",
      "The manometer board: coverage gaps visible before a single case is read",
      "Archivo across its width axis as the whole type system; mono only for measurements",
      "Safety yellow as a fill for the one control that starts a run, and as the engaged indicator on graphite"
    ],
    "rules": [
      {
        "name": "The Two Lights Rule",
        "body": "A surface is a daylight panel or a graphite window.",
        "section": "colors"
      },
      {
        "name": "The Yellow Is Paint Rule",
        "body": "Yellow is a fill or a lamp, never running text on a light ground. One yellow-filled control per surface, and it starts a run.",
        "section": "colors"
      },
      {
        "name": "The Fluid Rule",
        "body": "Red, amber, blue mean High, Medium, Low — always paired with fill height.",
        "section": "colors"
      },
      {
        "name": "The Width Axis Rule",
        "body": "Emphasis changes width and weight before it changes size.",
        "section": "typography"
      },
      {
        "name": "The Placard Rule",
        "body": "Placards label instruments and regions; never a kicker above a heading.",
        "section": "typography"
      },
      {
        "name": "The Measurement Rule",
        "body": "Mono for what is measured or identified. Prose is never mono.",
        "section": "typography"
      }
    ],
    "dos": [
      "Do keep reading on daylight panels and put the product's moments in graphite windows.",
      "Do use yellow as paint: one run button per surface, or an engaged lamp on graphite.",
      "Do pair every severity hue with fill height.",
      "Do scale emphasis through Archivo's width axis before reaching for size.",
      "Do give any grid child containing a min-width instrument min-w-0.",
      "Do keep the metaphor mapped to real behaviour — every instrument shows real data."
    ],
    "donts": [
      "Don't set yellow text on a light ground.",
      "Don't invent progress: the run shows a real elapsed clock, not a percentage.",
      "Don't put a placard above a heading as a kicker.",
      "Don't use mono for prose.",
      "Don't add glass, neon glows, or gradient text.",
      "Don't reintroduce flat, borderless minimalism — that is the world this replaced."
    ]
  }
