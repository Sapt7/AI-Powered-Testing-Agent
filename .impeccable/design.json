      "css": ".ds-mano{display:flex;gap:10px;padding:16px;background:#14161A;border-radius:12px}.ds-tube{display:flex;flex-direction:column;align-items:center;width:40px}.ds-tube b{font:500 12px \"JetBrains Mono\",monospace;color:#EEF2F7;margin-bottom:6px}.ds-tube.dry b{color:#8793A1}.ds-glass{position:relative;display:block;width:34px;height:140px;border:1px solid rgba(238,242,247,.2);border-radius:999px 999px 10px 10px;background:rgba(20,22,26,.8);overflow:hidden}.ds-tube.dry .ds-glass{border-style:dashed;border-color:rgba(238,242,247,.12)}.ds-fluid{position:absolute;left:0;right:0;bottom:0;display:flex;flex-direction:column}.ds-fluid i{display:block}.ds-fluid .h{background:#E0402E}.ds-fluid .m{background:#E99A1C}.ds-fluid .l{background:#307FD5}.ds-tube em{margin-top:10px;writing-mode:vertical-rl;transform:rotate(180deg);font:650 11px Archivo,sans-serif;font-style:normal;font-variation-settings:\"wdth\" 68;letter-spacing:.09em;text-transform:uppercase;color:#B2BCC7}"
