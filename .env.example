# --- Gemini ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# --- Server ---
# Leave PORT unset in hosted environments; the platform injects it.
PORT=8787

# --- Google sign-in ---
# The OAuth client ID is public: it identifies the client, it authorizes nothing.
# Both variables hold the same value. The server uses GOOGLE_CLIENT_ID as the
# required `aud` claim when verifying ID tokens; the browser bundle needs the
# VITE_-prefixed copy to initialize Google Identity Services.
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com

# --- Deployment ---
# Comma-separated browser origins allowed to call the API directly.
# Empty allows any origin, which is fine locally and wrong in production.
# CORS_ORIGIN=https://your-app.vercel.app

# Leave unset to keep API calls same-origin via the Vercel rewrite (recommended).
# Set only if the browser should call the backend directly, in which case
# CORS_ORIGIN must list this app's origin.
# VITE_API_BASE_URL=https://your-service.onrender.com

# --- Spend controls (see docs/decisions/0004-open-signup.md) ---
# All optional; these are the defaults. Override to tune without a code change.
# GENERATIONS_PER_USER_PER_HOUR=5
# GENERATIONS_GLOBAL_PER_DAY=100
# PARSES_PER_USER_PER_HOUR=40
