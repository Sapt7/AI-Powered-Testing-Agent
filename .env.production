# Build-time configuration for production builds.
#
# The OAuth client ID is a public identifier, not a secret — it is embedded in the
# browser bundle either way, and it authorizes nothing on its own. Committing it
# keeps production builds reproducible on any host without dashboard configuration.
#
# Never put GEMINI_API_KEY or any server secret in this file: everything here is
# compiled into the client bundle and is readable by anyone.
VITE_GOOGLE_CLIENT_ID=895232353971-o6dttnfjigbirv431qnfm4n41drbgntq.apps.googleusercontent.com
